# ==============================================================================
# JEV CV Evaluator - Enterprise Configuration (Fase 1)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a '.env.local':
#    cp .env.local.example .env.local
# 2. Configura tu API Key de TypeSafe AI y la conexión a PostgreSQL.
# 3. NOTA DE SEGURIDAD: '.env.local' está excluido en .gitignore y NUNCA debe subirse a Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Docker Compose)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://cv_admin:cv_secure_pass_2026@localhost:5432/cv_evaluator?schema=public"

# Variables para Docker Compose (opcional)
POSTGRES_USER=cv_admin
POSTGRES_PASSWORD=cv_secure_pass_2026
POSTGRES_DB=cv_evaluator
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. TypeSafe AI (JEV - Modelo Discriminativo System One)
# ------------------------------------------------------------------------------
TYPESAFE_API_KEY=tsa_live_tu_api_key_aqui
TYPESAFE_AI_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-1

# ------------------------------------------------------------------------------
# 3. Autenticación (NextAuth / Auth.js)
# ------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Genera un secreto seguro con: openssl rand -base64 32
NEXTAUTH_SECRET=super_secret_jwt_key_change_me_in_production_12345

# Fase 2: Google Workspace / Gmail OAuth (dejar vacío para usar Email/Password)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. Almacenamiento Local de Archivos CV
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage/cvs
