# ==============================================================================
# TypeSafe AI (JEV) - Configuración de Variables de Entorno
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a '.env.local':
#    cp .env.local.example .env.local
# 2. Configura tu API Key de TypeSafe AI.
# 3. NOTA DE SEGURIDAD: '.env.local' está excluido en .gitignore y NUNCA debe subirse a Git.
# ==============================================================================

# API Key de TypeSafe AI (JEV - Modelo Discriminativo System One)
TYPESAFE_API_KEY=tsa_live_tu_api_key_aqui

# (Opcional) URL Base de la API de TypeSafe AI
TYPESAFE_AI_BASE_URL=https://api.typesafe.ai/v1

# (Opcional) Modelo discriminativo JEV (default: jev-1)
TYPESAFE_MODEL=jev-1
