generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
}

enum VacancyStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  PROCESSING
  EVALUATED
  WRONG_LANGUAGE
  REJECTED
  ACCEPTED
}

enum ApplicationStage {
  APPLIED       // Postulado
  REVIEWING     // En Revisión
  INTERVIEW     // Entrevista
  OFFER         // Oferta
  HIRED         // Contratado
  REJECTED      // Descartado
}

enum EvaluationStatus {
  SUCCESS
  FAILED
  WRONG_LANGUAGE
}

enum RecommendationType {
  TOP_CANDIDATE
  POTENTIAL_FIT
  NOT_RECOMMENDED
  REVIEW_REQUIRED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum InvoiceProcessStatus {
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

enum InvoiceDocumentStatus {
  PENDING
  PROCESSING
  EVALUATED
  ERROR
}

enum InvoiceVerdict {
  APPROVED
  MANUAL_REVIEW
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  password     String?
  role         Role          @default(RECRUITER)
  vacancies    Vacancy[]
  evaluations  Evaluation[]
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Vacancy {
  id                 String            @id @default(cuid())
  title              String
  department         String
  description        String            @db.Text
  status             VacancyStatus     @default(ACTIVE)
  minScoreThreshold  Float             @default(2.5)
  weightSkills       Float             @default(0.40)
  weightExperience   Float             @default(0.35)
  weightEducation    Float             @default(0.15)
  weightLeadership   Float             @default(0.10)
  authorId           String
  author             User              @relation(fields: [authorId], references: [id])
  applications       Application[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Candidate {
  id           String         @id @default(cuid())
  fullName     String
  email        String?        @unique
  phone        String?
  linkedin     String?
  cvDocuments  CvDocument[]
  applications Application[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model CvDocument {
  id               String         @id @default(cuid())
  candidateId      String
  candidate        Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName         String
  fileSize         Int
  fileHash         String         @unique
  storagePath      String
  mimeType         String         @default("application/pdf")
  extractedText    String         @db.Text
  pageCount        Int            @default(1)
  detectedLanguage String?
  isLanguageValid  Boolean        @default(true)
  applications     Application[]
  createdAt        DateTime       @default(now())
}

model Application {
  id           String            @id @default(cuid())
  vacancyId    String
  vacancy      Vacancy           @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cvDocumentId String
  cvDocument   CvDocument        @relation(fields: [cvDocumentId], references: [id], onDelete: Cascade)
  status         ApplicationStatus @default(PENDING)
  stage          ApplicationStage  @default(APPLIED)
  recruiterNotes String?           @db.Text
  evaluation     Evaluation?
  jobQueue     JobQueue?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([vacancyId, candidateId])
}

model Evaluation {
  id                String             @id @default(cuid())
  applicationId     String             @unique
  application       Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluatorId       String?
  evaluator         User?              @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)
  status            EvaluationStatus   @default(SUCCESS)
  recommendation    RecommendationType
  overallScore      Float              // 0.0 - 4.0
  normalizedScore   Float              // 0 - 100%
  confidence        Float              // JEV confidence probability
  scoreSkills       Float
  scoreExperience   Float
  scoreEducation    Float
  scoreLeadership   Float
  jevRawResponses   Json               // complete logprobs, distribution, reasoning
  inputTokens       Int
  outputTokens      Int                @default(0)
  costUsd           Float              // $0.042 / 1M input tokens
  processingTimeMs  Int
  recruiterFeedback String?            @db.Text
  createdAt         DateTime           @default(now())
}

model JobQueue {
  id            String       @id @default(cuid())
  applicationId String       @unique
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  priority      Int          @default(0)
  status        JobStatus    @default(QUEUED)
  attempts      Int          @default(0)
  lastError     String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())
}

model InvoiceProcess {
  id                    String                @id @default(cuid())
  title                 String                // Ej: "Descargo de Gastos - Octubre 2026"
  description           String?               @db.Text
  periodMonth           String                // Ej: "Octubre"
  periodYear            Int                   // Ej: 2026
  employeeName          String                // Nombre completo del empleado que presenta el descargo
  employeeCi            String                // Cédula de Identidad / NIT (ej. "4892182 LP")
  department            String                @default("Finanzas")
  
  // Reglas configurables
  maxAmountThreshold    Float                 @default(10000.0) // Límite en Bs para revisión manual
  mathTolerance         Float                 @default(0.10)    // Tolerancia en Bs para suma de items
  suspiciousConcepts    String?               @db.Text          // Conceptos no propios de persona natural
  requireStrictCiMatch  Boolean               @default(true)
  
  status                InvoiceProcessStatus  @default(ACTIVE)
  invoices              InvoiceDocument[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model InvoiceDocument {
  id                    String                @id @default(cuid())
  processId             String
  process               InvoiceProcess        @relation(fields: [processId], references: [id], onDelete: Cascade)
  
  fileName              String
  fileSize              Int
  fileHash              String                // SHA-256
  storagePath           String
  mimeType              String                // application/pdf, image/jpeg, image/png, etc.
  
  // Datos extraídos de la factura
  buyerName             String?               // Nombre / Razón Social en la factura
  buyerCi               String?               // CI o NIT del comprador en la factura
  invoiceNumber         String?               // Nro de factura
  invoiceDate           String?               // Fecha de emisión
  totalAmount           Float?                // Monto total en Bs
  currency              String                @default("BOB")
  items                 Json?                 // Array de { description, quantity, unitPrice, subtotal }
  extractedText         String                @db.Text
  
  status                InvoiceDocumentStatus @default(PENDING)
  evaluation            InvoiceEvaluation?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model InvoiceEvaluation {
  id                     String                @id @default(cuid())
  invoiceId              String                @unique
  invoice                InvoiceDocument       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  verdict                InvoiceVerdict
  
  // Resultados específicos de cada regla
  identityMatch          Boolean               // ¿Coincide el nombre/CI con el empleado?
  identityMatchScore     Float                 @default(1.0)
  
  mathConsistent         Boolean               // ¿La suma de los ítems coincide con el total?
  calculatedSum          Float?                // Suma calculada de los ítems
  declaredTotal          Float?                // Total declarado en la factura
  sumDifference          Float?                // Diferencia absoluta
  
  amountAlert            Boolean               // ¿Supera el umbral (ej. 10.000 Bs)?
  
  suspiciousConceptAlert Boolean               // ¿Contiene conceptos no propios de persona natural?
  suspiciousDetails      String?               @db.Text
  
  // Resumen del veredicto y razones
  reasons                Json                  // Array de motivos
  jevReasoning           String                @db.Text
  jevRawResponse         Json?
  
  confidence             Float                 @default(1.0)
  inputTokens            Int                   @default(0)
  costUsd                Float                 @default(0.0) // $0.042 / 1M input tokens
  processingTimeMs       Int                   @default(0)
  
  // Revisión humana
  reviewerNotes          String?               @db.Text
  reviewedAt             DateTime?
  reviewedBy             String?
  
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}
