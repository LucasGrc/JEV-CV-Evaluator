# Instrucciones para puesta en marcha:
# 1. Copia este archivo a '.env':
#    cp .env.example .env
# 2. Si usas Docker Compose para PostgreSQL, DATABASE_URL ya tiene las credenciales listas.
# 3. Ingresa tu API Key de TypeSafe AI en TYPESAFE_AI_API_KEY (https://typesafe.ai).
# ==============================================================================

# Conexión a Base de Datos PostgreSQL (configuración por defecto de docker-compose.yml)
DATABASE_URL="postgresql://cv_admin:cv_secure_pass_2026@localhost:5432/cv_evaluator?schema=public"

# TypeSafe AI (JEV - System One Model)
# Tarifas oficiales: $0.042 por 1,000,000 tokens de entrada (salida gratis)
TYPESAFE_AI_API_KEY="tsa_live_tu_api_key_aqui"
TYPESAFE_API_KEY="tsa_live_tu_api_key_aqui"
TYPESAFE_AI_BASE_URL="https://api.typesafe.ai"
TYPESAFE_MODEL="jev-latest"

# NextAuth (Sesiones y autenticación)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cv_evaluator_jwt_secret_dev_2026_key"

# Almacenamiento local de archivos (PDFs y comprobantes)
STORAGE_DIR="./storage/cvs"
